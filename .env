SECRET_KEY=django-insecure-your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Флаг переключения БД: True для MySQL, False для SQLite
USE_MYSQL=False

# Настройки MySQL (заполните при использовании MySQL)[cite: 1]
DB_NAME=my_database
DB_USER=root
DB_PASSWORD=secret
DB_HOST=localhost
DB_PORT=3306